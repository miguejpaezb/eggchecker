# Copia este archivo a `.env` y ajusta los valores.
# Nunca subas `.env` al repositorio (ver .gitignore).

# En desarrollo se usa SQLite; en producción, MySQL.
DATABASE_URL=sqlite:///./eggchecker.db
# DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/eggchecker

JWT_SECRET_KEY=cambiar-esta-llave-en-produccion
JWT_ALGORITHM=HS256
# 129600 minutos = 90 días (sesión móvil de hasta 3 meses)
JWT_EXPIRE_MINUTES=129600

# Recuperación de contraseña
RECOVERY_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Análisis de huevos con IA (RF-33 a RF-36). Llave gratuita en
# https://aistudio.google.com/apikey . Sin llave, el módulo responde en
# modo demostración con un diagnóstico de ejemplo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
IA_TIMEOUT_SEGUNDOS=45
IA_UPLOAD_DIR=uploads/analisis
IA_MAX_MB=8
IA_LIMITE_DIARIO=20
