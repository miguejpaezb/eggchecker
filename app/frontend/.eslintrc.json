{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": ["airbnb", "airbnb/hooks", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "settings": {
    "react": { "version": "detect" }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "labelComponents": [],
        "labelAttributes": [],
        "controlComponents": [
          "InputDecimal",
          "CategoriaAutocomplete",
          "CamadaAutocomplete"
        ],
        "assert": "both",
        "depth": 3
      }
    ]
  }
}
