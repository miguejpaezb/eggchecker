# Normaliza los finales de línea del repositorio a LF.
* text=auto eol=lf

# Los scripts de Windows conservan CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Archivos binarios.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.pdf binary
